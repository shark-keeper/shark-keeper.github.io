{
  // 상어집사 API 서버 (Cloudflare Workers)
  // Cloudflare 대시보드의 Worker 이름과 반드시 같아야 한다 (Workers Builds 연동).
  "name": "shark-keeper-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shark-keeper",
      "database_id": "05d64fc1-f16c-419e-93c5-dccc8efeed5a"
    }
  ],
  // 1시간마다(매시 7분) 오래 접속하지 않은 상어를 정산해 랭킹·사망을 반영한다
  "triggers": { "crons": ["7 * * * *"] },
  // 광고 보상 모드: "test" = 앱이 보고한 보상도 인정(테스트 광고 ID·웹 목업용)
  //                 "ssv"  = AdMob 서버 검증(/api/admob/ssv)으로만 지급 — 실제 광고 ID로 출시할 때 바꾼다
  "vars": { "ADS_MODE": "ssv" }
  // 테이블은 src/schema.js가 첫 요청 때 자동으로 만든다
}
